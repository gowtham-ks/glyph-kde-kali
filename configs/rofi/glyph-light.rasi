/* Glyph Lite Light rofi theme - generated by glyph-lite */
* {
    bg:        #F2F2F0F2;
    bg-alt:    #E8E8E6FF;
    fg:        #101012FF;
    muted:     #6E6E72FF;
    accent:    #D71921FF;
    on-accent: #FFFFFFFF;
    background-color: transparent;
    text-color: @fg;
    font: "JetBrains Mono 11";
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 26px;
    padding: 20px;
}

mainbox { children: [inputbar, listview]; spacing: 14px; }

inputbar {
    children: [prompt, entry];
    background-color: @bg-alt;
    border-radius: 999px;
    padding: 12px 20px;
    spacing: 12px;
}

prompt { text-color: @accent; }
entry { placeholder: "SEARCH"; placeholder-color: @muted; }

listview { lines: 7; columns: 1; fixed-height: false; scrollbar: false; spacing: 4px; }

element { padding: 10px 16px; border-radius: 13px; spacing: 12px; }
element-icon { size: 24px; }
element-text { vertical-align: 0.5; text-color: inherit; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
