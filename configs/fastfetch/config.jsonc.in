{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@CONF@/fastfetch/glyph-logo.txt",
    "color": { "1": "38;2;215;25;33", "2": "38;2;240;240;242" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " ∷ ",
    "color": { "keys": "38;2;215;25;33", "title": "38;2;255;255;255" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "・・・・・・・・・・・・・・・・・・" },
    { "type": "os",       "key": "SYS // OS " },
    { "type": "kernel",   "key": "SYS // KRN" },
    { "type": "uptime",   "key": "SYS // UPT" },
    { "type": "de",       "key": "GUI // DE " },
    { "type": "wm",       "key": "GUI // WM " },
    { "type": "shell",    "key": "TRM // SHL" },
    { "type": "terminal", "key": "TRM // EMU" },
    { "type": "packages", "key": "PKG // TOT" },
    { "type": "cpu",      "key": "CPU // ---" },
    { "type": "memory",   "key": "MEM // RAM" },
    { "type": "disk",     "key": "DSK // / ", "folders": "/" },
    { "type": "custom", "format": "・・・・・・・・・・・・・・・・・・" },
    "colors"
  ]
}
